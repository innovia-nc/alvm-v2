# NextAuth v5 (Auth.js) — obligatoire en production (fail-closed au boot sinon)
AUTH_SECRET=CHANGEZ_MOI_generer_avec_openssl_rand_base64_32
# URL publique, sans slash final — liens de réinitialisation de mot de passe
AUTH_URL=https://alvm.example.nc

# Neon PostgreSQL (variables auto-injectées par l'intégration Vercel ↔ Neon)
# POSTGRES_PRISMA_URL   = URL poolée (pgbouncer) — utilisée au runtime
# POSTGRES_URL_NON_POOLING = connexion directe — migrations / prisma db push
POSTGRES_PRISMA_URL=postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/neondb?sslmode=require

# Vercel Blob (PDF des factures, futurs uploads)
# Token auto-injecté par Vercel quand le store Blob est connecté au projet
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Store privé (documents enfants/staff, PDF). Surchargeable dans la super administration.
BLOB_PRIVATE_READ_WRITE_TOKEN=vercel_blob_rw_...

# Envoi d'emails transactionnels (facture/devis au parent) — Resend
# Absent = l'application le dit explicitement et désactive les boutons d'envoi,
# elle ne casse pas. L'expéditeur (nom, adresse, reply-to) se règle dans
# /dashboard/admin/settings, section Email.
RESEND_API_KEY=re_...

# Chiffrement des clés API configurées dans la super administration (32 octets, base64).
# Générer avec : openssl rand -base64 32. Conserver cette clé lors des redéploiements.
PLATFORM_ENCRYPTION_KEY=

# Hors Vercel uniquement (srv-ovh / Coolify) : nombre de relais de confiance
# devant l'application, pour lire l'IP client dans X-Forwarded-For (limitation
# des tentatives de connexion). Traefik seul : 1 ; Cloudflare proxy + Traefik : 2.
# Absent/0 : toutes les connexions partagent le même quota (100 / 15 min).
TRUSTED_PROXY_HOPS=
