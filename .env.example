# ─────────────────────────────────────────────────────────────────────────────
# Asso SaaS (ALVM) — variables d'environnement. Jamais de valeur sensible ici.
# Développement local : `docker compose up -d` (compose.yml) puis ces valeurs.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — DEUX rôles (docs/adr/0002-multi-tenant-rls.md)
# Rôle applicatif NOSUPERUSER NOBYPASSRLS : la Row Level Security s'applique.
DATABASE_URL=postgresql://alvm_app:alvm_app@localhost:5436/alvm_dev
# Propriétaire du schéma : migrations (`pnpm db:migrate`) uniquement.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5436/alvm_dev

# NextAuth v5 (Auth.js) — obligatoire en production (fail-closed au boot sinon)
AUTH_SECRET=CHANGEZ_MOI_generer_avec_openssl_rand_base64_32
# URL publique, sans slash final — liens de réinitialisation de mot de passe
AUTH_URL=http://localhost:3000

# Chiffrement des clés API configurées dans la super administration (32 octets, base64).
# Générer avec : openssl rand -base64 32. À sauvegarder : la perdre rend les clés illisibles.
PLATFORM_ENCRYPTION_KEY=

# Stockage des fichiers (Vercel Blob, API par jeton). Surchargeables depuis la super administration.
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Emails transactionnels (Resend). Absent : envoi désactivé et expliqué à l'écran.
RESEND_API_KEY=
# Adresse d'expédition par défaut de la plateforme (domaine vérifié chez Resend) ;
# une association peut la remplacer dans ses paramètres email.
EMAIL_FROM_ADDRESS=

# Nombre de relais de confiance devant l'application (X-Forwarded-For).
# Traefik seul : 1 ; Cloudflare proxy + Traefik : 2. Absent/0 : quota partagé.
TRUSTED_PROXY_HOPS=
