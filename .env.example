# NextAuth v5 (Auth.js)
AUTH_SECRET=CHANGEZ_MOI_generer_avec_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# Supabase PostgreSQL (auto-populated by Vercel Supabase integration)
POSTGRES_PRISMA_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Vercel Blob (PDF des factures, futurs uploads)
# Token auto-injecté par Vercel quand le store Blob est connecté au projet
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
