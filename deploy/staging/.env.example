# deploy/staging/.env — staging srv-innovia. Non versionné, `chmod 600`.
# Aucune valeur de production ici. Détail des variables de chaque service :
# alvm-back/.env.example et alvm-front/.env.example.

# Port de base du bloc : `staging-ports list` après `staging-ports alloc asso-saas`.
BASE_PORT=
# SHA court du commit déployé : IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=
# Doit valoir exactement `staging-ports url asso-saas`.
APP_URL=https://srv-innovia.taild93c02.ts.net:<BASE_PORT>
# Un seul relais devant le front : `tailscale serve`.
TRUSTED_PROXY_HOPS=1

# Mots de passe inclus dans une URL : openssl rand -hex 32 (rien à échapper).
POSTGRES_PASSWORD=
ALVM_APP_DB_PASSWORD=
REDIS_PASSWORD=

# Partagés front ↔ back : openssl rand -base64 32 / openssl rand -hex 32
AUTH_SECRET=
INTERNAL_API_SECRET=
# openssl rand -base64 32
PLATFORM_ENCRYPTION_KEY=

# Optionnels. Stores Blob DÉDIÉS au staging — jamais ceux de la prod (TD-006).
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
