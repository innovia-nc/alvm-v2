# deploy/ovh/.env — variables de compose.ovh.yml (répétition de la production
# sur un hôte Docker). Non versionné, `chmod 600`. Jamais de valeur réelle ici.
#
# En production Coolify, ces valeurs se saisissent dans l'interface, service
# par service : docs/deploiement-ovh.md § 3. Le détail des variables validées
# au démarrage de chaque service est dans alvm-back/.env.example et
# alvm-front/.env.example.
#
# Mots de passe inclus dans une URL (PostgreSQL, Redis) : `openssl rand -hex 32`
# (hexadécimal : aucun caractère à échapper).

# SHA court du commit construit : IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=

# PostgreSQL — propriétaire du schéma (migrate uniquement) et rôle applicatif alvm_app
POSTGRES_USER=alvm_owner
POSTGRES_DB=alvm
POSTGRES_PASSWORD=
ALVM_APP_DB_PASSWORD=

# Redis (file d'emails)
REDIS_PASSWORD=

# Partagés front ↔ back (valeurs IDENTIQUES dans les deux services)
AUTH_SECRET=                  # openssl rand -base64 32
INTERNAL_API_SECRET=          # openssl rand -hex 32

# URL publique du front, sans slash final
AUTH_URL=https://
# Cloudflare proxy + Traefik : 2
TRUSTED_PROXY_HOPS=2

# 32 octets base64 — À SAUVEGARDER hors du serveur
PLATFORM_ENCRYPTION_KEY=      # openssl rand -base64 32

# Optionnels (surchargeables en super administration)
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
