# ─────────────────────────────────────────────────────────────────────────────
# alvm-front (Next.js) — validé au démarrage par lib/env.ts (instrumentation.ts).
# Copier en .env.local (non versionné). Aucune variable NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# Partagés avec alvm-back (valeurs IDENTIQUES) — 32 caractères minimum.
AUTH_SECRET=
INTERNAL_API_SECRET=

# URL publique du front, sans slash final.
AUTH_URL=http://localhost:3000

# Back NestJS sur le réseau interne (Coolify : alias réseau `alvm-back`).
API_INTERNAL_URL=http://localhost:4001

# Relais de confiance devant le front (Traefik seul : 1 ; Cloudflare + Traefik : 2).
TRUSTED_PROXY_HOPS=
