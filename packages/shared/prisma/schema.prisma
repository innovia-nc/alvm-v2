model ParentCredit {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Tenant : renseigné par défaut depuis le contexte RLS de la transaction (app.org_id).
  organizationId  String       @default(dbgenerated("app_current_org_id()")) @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentId        String       @map("parent_id") @db.Uuid
  creditNoteId    String       @unique @map("credit_note_id") @db.Uuid
  amountOriginal  Decimal      @map("amount_original") @db.Decimal(10, 2)
  amountRemaining Decimal      @map("amount_remaining") @db.Decimal(10, 2)
  currency        String?      @default("XPF")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz()
  notes           String?

  parent       Parent              @relation(fields: [parentId], references: [userId], onDelete: Cascade)
  creditNote   Invoice             @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  applications CreditApplication[]

  @@index([parentId, expiresAt, createdAt])
  @@index([organizationId])
  @@map("parent_credits")
}

model CreditApplication {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Tenant : renseigné par défaut depuis le contexte RLS de la transaction (app.org_id).
  organizationId String       @default(dbgenerated("app_current_org_id()")) @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentCreditId String       @map("parent_credit_id") @db.Uuid
  registrationId String?      @map("registration_id") @db.Uuid
  invoiceId      String?      @map("invoice_id") @db.Uuid
  amountUsed     Decimal      @map("amount_used") @db.Decimal(10, 2)
  appliedAt      DateTime     @default(now()) @map("applied_at") @db.Timestamptz()
  appliedBy      String       @map("applied_by") @db.Uuid
  notes          String?

  parentCredit ParentCredit  @relation(fields: [parentCreditId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  applier      User          @relation("CreditApplier", fields: [appliedBy], references: [id])

  @@index([organizationId])
  @@map("credit_applications")
}

model CreditNoteAllocation {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Tenant : renseigné par défaut depuis le contexte RLS de la transaction (app.org_id).
  organizationId     String       @default(dbgenerated("app_current_org_id()")) @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creditNoteId       String       @map("credit_note_id") @db.Uuid
  appliedToInvoiceId String       @map("applied_to_invoice_id") @db.Uuid
  amount             Decimal      @db.Decimal(10, 2)
  allocationDate     DateTime     @default(dbgenerated("CURRENT_DATE")) @map("allocation_date") @db.Date
  notes              String?
  recordedBy         String       @map("recorded_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
