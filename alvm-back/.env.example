# ─────────────────────────────────────────────────────────────────────────────
# alvm-back (API NestJS + worker) — validé au démarrage par src/config/env.ts.
# Copier en .env.local (non versionné). Jamais de valeur sensible ici.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001

# PostgreSQL — DEUX rôles (docs/adr/0002-multi-tenant-rls.md)
# Rôle applicatif NOSUPERUSER NOBYPASSRLS : la Row Level Security s'applique.
DATABASE_URL=postgresql://alvm_app:alvm_app@localhost:5436/alvm_dev
# Propriétaire du schéma : migrations (`pnpm db:migrate`) uniquement.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5436/alvm_dev

# Partagés avec alvm-front (valeurs IDENTIQUES) — 32 caractères minimum.
AUTH_SECRET=                  # openssl rand -base64 32
INTERNAL_API_SECRET=          # openssl rand -hex 32

# URL publique du front, sans slash final (liens des emails de réinitialisation).
AUTH_URL=http://localhost:3000

# Chiffrement des clés API saisies en super administration (32 octets base64).
# À sauvegarder : la perdre rend les clés illisibles. Requis en production.
PLATFORM_ENCRYPTION_KEY=      # openssl rand -base64 32

# File d'emails BullMQ (alvm-email). Requis en production.
REDIS_URL=redis://localhost:6380

# Emails (Resend) : clé surchargeable en super administration ; expéditeur par
# défaut de la plateforme (domaine vérifié chez Resend).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Stockage des fichiers (Vercel Blob, API par jeton), surchargeable en super administration.
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
