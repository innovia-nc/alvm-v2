{
  "name": "@alvm/back",
  "version": "3.0.0",
  "private": true,
  "description": "Back NestJS 11 : API tRPC + routes HTTP (documents, PDF, téléversements), file d'emails BullMQ.",
  "exports": {
    "./trpc": "./src/trpc/trpc.router.ts"
  },
  "prisma": {
    "schema": "../packages/shared/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env.local src/worker.ts",
    "build": "pnpm --filter @alvm/shared db:generate && tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "pnpm --filter @alvm/shared db:generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:create-super-admin": "tsx --env-file-if-exists=.env.local scripts/create-super-admin.ts"
  },
  "dependencies": {
    "@alvm/shared": "workspace:*",
    "@auth/core": "0.41.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.0.0",
    "@react-pdf/renderer": "^4.3.2",
    "@trpc/server": "^11.12.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.0",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "superjson": "^2.2.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "prisma": "^6.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
