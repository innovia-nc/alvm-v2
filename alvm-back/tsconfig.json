{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "types": ["node"],
    "paths": {
      "@back/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "test/**/*", "*.config.ts"]
}
